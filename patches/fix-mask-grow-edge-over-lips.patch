+    e.renderer.accessory.draw(lm, 1.); out[e.renderer.accessory.last_alpha > .5] = 7
+    res, lm2 = e.lip_safety(bgr, lm, out)
+    assert res is not None and e.renderer.calls == 0 and e.edge_grow_count == 1
+    assert (res[84:89, 70:90] == 7).all()                    # sliver now wearable-coloured
+    assert (res[60:80, 70:90] == 50).all()                   # nothing grown far from the lips
+    assert np.allclose(lm2, lm)
 
 
