+ def mouth_visible(self,bgr):
+  """Current frame only: is any mouth visible that the wearable would have to cover?
+  No face skin, or face skin without lip pixels (face above the frame edge, back of
+  the head, turned away) means there is nothing to hide, so the original pixels are
+  correct. Any doubt or model failure answers True and keeps the existing guard."""
+  try:
+   from .face_guard import FaceGuard
+   if self.guard_model is None:self.guard_model=FaceGuard()
+   h,w=bgr.shape[:2];face=self.guard_model.probability(bgr)
+   if face.shape!=(h,w):face=cv2.resize(face,(w,h),interpolation=cv2.INTER_LINEAR)
+   skin=face>.35
+   if skin.sum()<max(64,h*w*.0004):return False
+   ys,xs=np.where(skin);x0,x1,y0,y1=xs.min(),xs.max(),ys.min(),ys.max();side=max(x1-x0,y1-y0,48)*1.5;cx=(x0+x1)/2;cy=(y0+y1)/2
+   roi=bgr[max(0,int(cy-side/2)):min(h,int(cy+side/2)),max(0,int(cx-side/2)):min(w,int(cx+side/2))]
+   if self.mouth_refiner is None:
+    from .mouth_region import MouthRegion
+    self.mouth_refiner=MouthRegion()
+   return self.mouth_refiner.lip_pixels(roi)>=12
+  except Exception:
+   return True
+ def untracked(self,bgr,index):
+  self.previous=None
+  if not(self.fitted_mask and self.guard=='protect'):return bgr
+  if not self.mouth_visible(bgr):
+   self.hidden_mouth_count=getattr(self,'hidden_mouth_count',0)+1
+   if getattr(self,'qualities',None) and index<len(self.qualities):self.qualities[index]='mouth_hidden'
+   return bgr
+  return self.protected(bgr)
  def apply(self,bgr,index,fps):
   h,w=bgr.shape[:2];rgb=cv2.cvtColor(bgr,cv2.COLOR_BGR2RGB)
   if self.cached is not None:
    lm=self.cached[index] if index<len(self.cached) else None
-   if lm is None:self.previous=None;return self.protected(bgr) if self.fitted_mask and self.guard=='protect' else bgr
+   if lm is None:return self.untracked(bgr,index)
   else:
    result=self.landmarker.detect_for_video(self.mp.Image(image_format=self.mp.ImageFormat.SRGB,data=rgb),int(index*1000/fps))
-   if not result.face_landmarks:self.previous=None;return self.protected(bgr) if self.fitted_mask and self.guard=='protect' else bgr
+   if not result.face_landmarks:return self.untracked(bgr,index)
    lm=np.array([(p.x*w,p.y*h,p.z*w) for p in result.face_landmarks[0]],np.float32)
   out=self.renderer.apply(bgr,lm,self.scale,self.opacity,self.offset)
   if self.fitted_mask and self.guard=='protect' and (self.renderer.last_coverage if self.mouth_cover else self.renderer.accessory.last_coverage)<.98:return self.protected(bgr,lm)
