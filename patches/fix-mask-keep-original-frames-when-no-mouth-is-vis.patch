@@ -0,0 +1,67 @@
+import numpy as np
+import pytest
+from app.processing import FaceEffect
+
+
+class Skin:
+    """Stub FaceGuard: face-skin probability map, or a failure."""
+    def __init__(self, prob=None, fail=False):
+        self.prob, self.fail = prob, fail
+    def probability(self, bgr):
+        if self.fail: raise RuntimeError('segmenter unavailable')
+        return self.prob
+    def mask(self, bgr):
+        raise AssertionError('semantic mosaic must not run in strict clothing mode')
+
+
+class Lips:
+    def __init__(self, count): self.count = count; self.calls = 0
+    def lip_pixels(self, roi): self.calls += 1; return self.count
+
+
+def effect(prob=None, lips=0, fail=False):
+    e = FaceEffect.__new__(FaceEffect)
+    e.fitted_mask = True; e.guard = 'protect'; e.product_type = 'clothing'; e.strict_product = True
+    e.guarded_count = e.guard_local_count = e.guard_full_count = e.hidden_mouth_count = 0
+    e.guard_model = Skin(prob, fail); e.mouth_refiner = Lips(lips)
+    e.cached = [None]; e.qualities = ['none']; e.previous = None
+    return e
+
+
+def frame(): return np.full((120, 80, 3), 90, np.uint8)
+
+
+def chin_only():
+    p = np.zeros((120, 80), np.float32); p[0:20, 25:55] = .9  # face skin cut by the top edge
+    return p
+
+
+def test_no_face_skin_keeps_original_frame_in_strict_clothing_mode():
+    e = effect(np.zeros((120, 80), np.float32))
+    f = frame(); out = e.apply(f, 0, 24)
+    assert out is f and e.hidden_mouth_count == 1 and e.qualities[0] == 'mouth_hidden'
+    assert e.mouth_refiner.calls == 0
+
+
+def test_face_without_lips_keeps_original_frame():
+    e = effect(chin_only(), lips=0)
+    f = frame(); out = e.apply(f, 0, 24)
+    assert out is f and e.hidden_mouth_count == 1 and e.guarded_count == 0
+
+
+def test_visible_lips_without_landmarks_still_stop_clothing_export():
+    e = effect(chin_only(), lips=40)
+    with pytest.raises(RuntimeError, match='避免改变衣服或露嘴'):
+        e.apply(frame(), 0, 24)
+    assert e.hidden_mouth_count == 0
+
+
+def test_visibility_check_failure_falls_back_to_existing_guard():
+    e = effect(fail=True)
+    with pytest.raises(RuntimeError, match='避免改变衣服或露嘴'):
+        e.apply(frame(), 0, 24)
+
+
+def test_unguarded_templates_are_unchanged():
+    e = effect(np.zeros((120, 80), np.float32)); e.fitted_mask = False
+    f = frame(); assert e.apply(f, 0, 24) is f and e.hidden_mouth_count == 0
