+++ b/app/landmark_smooth.py
@@ -0,0 +1,44 @@
+"""Offline temporal smoothing of landmark tracks for recorded video.
+
+Per-frame landmarks jitter by a few pixels, which makes a wearable shimmer. For recorded
+video the whole track is known, so a One Euro filter is run forward and backward and the
+two passes are averaged: still frames are smoothed strongly, fast motion keeps its shape,
+and there is no lag. Tracks are smoothed only inside continuous runs, never across a shot
+cut or a frame without landmarks.
+"""
+import math
+import numpy as np
+
+
+def _alpha(cutoff, fps):
+    tau = 1.0 / (2 * math.pi * cutoff); return 1.0 / (1.0 + tau * fps)
+
+
+def _one_euro(seq, fps, min_cutoff, beta, d_cutoff=1.0):
+    out = np.empty_like(seq); out[0] = seq[0]; dx = np.zeros_like(seq[0]); a_d = _alpha(d_cutoff, fps)
+    for i in range(1, len(seq)):
+        dx = a_d * (seq[i] - out[i - 1]) * fps + (1 - a_d) * dx
+        # Speed of the whole face (not per point): all points get the same cutoff, so the
+        # mesh keeps its shape instead of individual vertices lagging differently.
+        speed = float(np.linalg.norm(dx, axis=-1).mean())
+        a = _alpha(min_cutoff + beta * speed, fps)
+        out[i] = a * seq[i] + (1 - a) * out[i - 1]
+    return out
+
+
+def smooth(points, fps, cuts=(), scale=None, min_cutoff=1.0, beta=0.02):
+    """Return a new list; None entries stay None. `scale` (face size in px) normalises speed."""
+    out = list(points); cuts = set(cuts); n = len(points); i = 0
+    while i < n:
+        if points[i] is None: i += 1; continue
+        a = i; i += 1
+        while i < n and points[i] is not None and i not in cuts: i += 1
+        run = np.stack([np.asarray(p, np.float32) for p in points[a:i]])
+        if len(run) < 3: continue
+        s = scale or float(np.ptp(run[0][:468, 0])) or 1.0
+        b = beta * 200.0 / s  # same feel for small and large faces
+        fwd = _one_euro(run, fps, min_cutoff, b)
+        bwd = _one_euro(run[::-1], fps, min_cutoff, b)[::-1]
+        sm = (fwd + bwd) / 2
+        for k in range(a, i): out[k] = sm[k - a]
+    return out
