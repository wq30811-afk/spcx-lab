diff --git a/tests/test_landmark_smooth.py b/tests/test_landmark_smooth.py
new file mode 100644
index 0000000..857e621
--- /dev/null
+++ b/tests/test_landmark_smooth.py
@@ -0,0 +1,41 @@
+import numpy as np
+from app.landmark_smooth import smooth
+
+FPS = 24.0
+rng = np.random.default_rng(0)
+
+
+def face(x, y):
+    p = np.zeros((478, 3), np.float32); p[:, 0] = x + np.linspace(-100, 100, 478); p[:, 1] = y; return p
+
+
+def centre(p): return np.asarray(p)[:, :2].mean(0)
+
+
+def test_still_face_jitter_is_reduced():
+    pts = [face(360, 400) + rng.normal(0, 3, (478, 3)).astype(np.float32) for _ in range(72)]
+    out = smooth(pts, FPS)
+    raw = np.std([centre(p) for p in pts], axis=0).mean(); sm = np.std([centre(p) for p in out], axis=0).mean()
+    assert sm < raw * 0.5
+
+
+def test_fast_motion_is_followed_without_lag():
+    xs = np.r_[np.full(24, 200.), np.linspace(200, 600, 12), np.full(24, 600.)]
+    out = smooth([face(x, 400) for x in xs], FPS)
+    err = np.abs(np.array([centre(p)[0] for p in out]) - xs)
+    assert err.max() < 40 and err[-12:].max() < 2 and err[:12].max() < 2
+
+
+def test_runs_are_not_mixed_across_gaps_or_cuts():
+    pts = [face(100, 400)] * 10 + [None] + [face(600, 400)] * 10
+    out = smooth(pts, FPS)
+    assert out[10] is None and abs(centre(out[9])[0] - 100) < 1e-3 and abs(centre(out[11])[0] - 600) < 1e-3
+    pts = [face(100, 400)] * 10 + [face(600, 400)] * 10
+    out = smooth(pts, FPS, cuts=[10])
+    assert abs(centre(out[9])[0] - 100) < 1e-3 and abs(centre(out[10])[0] - 600) < 1e-3
+
+
+def test_short_runs_and_input_are_untouched():
+    pts = [face(100, 400), face(130, 400)]
+    out = smooth(pts, FPS)
+    assert out[0] is pts[0] and out[1] is pts[1]
