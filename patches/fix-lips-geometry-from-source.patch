+def merge_tail(chunks,tail,probe=5):
+ """Append the segment-mode tail. Word mode sometimes crams the last stretch of speech into an
+ earlier sentence; when the tail's opening words already appear there, that copy is cut so the
+ speech is kept once, at the segment-mode timing."""
+ chunks=[dict(c) for c in chunks]
+ head=next((t['text'] for t in tail if len(t['text'])>=probe),None)
+ if head:
+  key=head[:probe]
+  for k in range(len(chunks)-1,max(-1,len(chunks)-4),-1):
+   at=chunks[k]['text'].find(key)
+   if at<0:continue
+   kept=chunks[k]['text'][:at].rstrip(',，、 ')
+   chunks=chunks[:k]+([dict(chunks[k],text=kept)] if kept else [])
+   break
+ return chunks+list(tail)
+
