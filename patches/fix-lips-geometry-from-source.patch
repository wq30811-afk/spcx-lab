-BROWS=([70,63,105,66,107],[336,296,334,293,300])
-def _anchors(p):return np.array([p[BROWS[0],:2].mean(0),p[BROWS[1],:2].mean(0),p[1,:2]])
-def verify(previous,current,previous_points,detected,tolerance=.15):
- """Cross-check a fresh detection against the pixels. A detector can misplace the whole face
- for several frames (e.g. after a hand sweeps past) while the image barely changes. When the
- detection jumps from the previous points by more than `tolerance` of the face size and
- optical flow of the actual face texture disagrees by as much, the flow-tracked points are
- returned instead. Returns (points, overridden)."""
- if detected is None or previous_points is None or not np.isfinite(previous_points[[1]+BROWS[0]+BROWS[1],:2]).all():return detected,False
- a,d=_anchors(previous_points),_anchors(detected);size=float(np.linalg.norm(a[0]-a[1])) or 1.
- if float(np.linalg.norm(d-a,axis=1).max())/size<=tolerance:return detected,False
- tracked=follow(previous,current,previous_points)
- if tracked is None:return detected,False
- if float(np.linalg.norm(d-_anchors(tracked),axis=1).max())/size<=tolerance:return detected,False
- return tracked,True
