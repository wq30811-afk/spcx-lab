From cd681b0141f75f69b248ca48d757790acac49e67 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 2 Nov 2026 19:46:42 +0900
Subject: [PATCH] fix(mask): pixel-level lip check keeps the wearable on the
 real mouth

Landmarks can be misplaced on profiles and partial faces, so a landmark-based coverage
check passed while the upper lip showed above the wearable. After rendering, a lip parser
on the current frame now looks for lip pixels outside the wearable near this face's mouth;
the wearable is moved and, if needed, enlarged toward them, and frames that still expose
lips go to the existing guard. The edge-exit slide is damped so the wearable leaves the
frame slower than the lips.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015XEHdEnhr7p5ae4FL4TjbE
---
 app/face_flow_gaps.py    |  2 +-
 app/mouth_region.py      |  6 +++
 app/processing.py        | 42 +++++++++++++++++++++
 tests/test_lip_safety.py | 79 ++++++++++++++++++++++++++++++++++++++++
 4 files changed, 128 insertions(+), 1 deletion(-)
 create mode 100644 tests/test_lip_safety.py

diff --git a/app/face_flow_gaps.py b/app/face_flow_gaps.py
index d19d0ae..41cbc7c 100644
--- a/app/face_flow_gaps.py
+++ b/app/face_flow_gaps.py
@@ -31,7 +31,7 @@ def edge_extend(points,w,h,cuts=(),limit=12,margin=None):
   b=i-1
   for anchor,step in ((a-1,1),(b+1,-1)):
    if not 0<=anchor<n or points[anchor] is None or _edge_gap(points[anchor],w,h,margin)>margin:continue
-   v=_motion(points,anchor,step)
+   v=_motion(points,anchor,step)*.5  # slower than the lips: cover a little chin rather than expose lip
    for d in range(1,limit+1):
     k=anchor+step*d
     if not a<=k<=b or points[k] is not None:break
diff --git a/app/mouth_region.py b/app/mouth_region.py
index 0a5cbe6..aaeee5b 100644
--- a/app/mouth_region.py
+++ b/app/mouth_region.py
@@ -38,6 +38,12 @@ class MouthRegion:
   logit=r-r.max(0,keepdims=True);probs=np.exp(logit);probs/=probs.sum(0,keepdims=True)
   return int((probs[11:14].sum(0)>threshold).sum())
 
+ def lip_mask(self,roi,threshold=.5):
+  """Boolean lip/mouth mask at the crop's own size (face-sized crop expected)."""
+  rgb=cv2.cvtColor(cv2.resize(roi,(512,512)),cv2.COLOR_BGR2RGB).astype(np.float32)/255;rgb=(rgb-np.array([.485,.456,.406],np.float32))/np.array([.229,.224,.225],np.float32);r=self.s.run(None,{'input':rgb.transpose(2,0,1)[None]})[0][0]
+  logit=r-r.max(0,keepdims=True);probs=np.exp(logit);probs/=probs.sum(0,keepdims=True)
+  return cv2.resize((probs[11:14].sum(0)>threshold).astype(np.uint8),(roi.shape[1],roi.shape[0]),interpolation=cv2.INTER_NEAREST)>0
+
  def detect_closeup(self,f):
   # Face parsing requires a face-sized ROI; the full-body frame is not its
   # training distribution. Always infer from fresh pixels, never borrow a mouth.
diff --git a/app/processing.py b/app/processing.py
index 84ef612..080adb4 100644
--- a/app/processing.py
+++ b/app/processing.py
@@ -68,6 +68,45 @@ class FaceEffect:
    return self.mouth_refiner.lip_pixels(roi)>=12
   except Exception:
    return True
+ def lip_safety(self,bgr,lm,out):
+  """Pixel check independent of landmarks: lips the parser finds in the current frame must
+  sit under the rendered wearable. Misplaced landmarks (profile, partial face) are corrected
+  by moving/enlarging the wearable toward the real lips; if that still leaves lips exposed
+  the frame returns None and the existing guard decides. A failing check keeps `out`."""
+  acc=getattr(self.renderer,'accessory',None)
+  if acc is None:return out,lm
+  try:
+   if self.mouth_refiner is None:
+    from .mouth_region import MouthRegion
+    self.mouth_refiner=MouthRegion()
+   h,w=bgr.shape[:2];p=np.asarray(lm,np.float32)[:468,:2];lo=p.min(0);hi=p.max(0);cx,cy=(lo+hi)/2;side=max(hi-lo)*1.3
+   x0,y0,x1,y1=max(0,int(cx-side/2)),max(0,int(cy-side/2)),min(w,int(cx+side/2)),min(h,int(cy+side/2))
+   if x1-x0<16 or y1-y0<16:return out,lm
+   lips=np.zeros((h,w),bool);lips[y0:y1,x0:x1]=self.mouth_refiner.lip_mask(bgr[y0:y1,x0:x1])
+  except Exception:
+   return out,lm
+  from .face_flow_gaps import LIPS
+  # Only lip components near this face's mouth count: pink clothing or jewellery in the
+  # crop must not drag the wearable, while a mouth a little off the landmarks still does.
+  P=np.asarray(lm,np.float32);mouth=P[LIPS,:2].mean(0);width=float(np.linalg.norm(P[61,:2]-P[291,:2]))+1;reach=max(width*1.6,max(hi-lo)*.25)
+  n,labels,stats,centers=cv2.connectedComponentsWithStats(lips.astype(np.uint8));near=np.zeros(n,bool)
+  for k in range(1,n):near[k]=np.linalg.norm(centers[k]-mouth)<=reach
+  lips=near[labels];total=int(lips.sum())
+  if total<10:return out,lm
+  ys,xs=np.where(lips);target=np.array([xs.mean(),ys.mean()],np.float32)
+  for attempt in range(3):
+   alpha=getattr(acc,'last_alpha',None)
+   if alpha is None or alpha.shape!=(h,w):return out,lm
+   if int((lips&(alpha<.5)).sum())<=max(4,total*.02):
+    if attempt:self.lip_fix_count=getattr(self,'lip_fix_count',0)+1
+    return out,lm
+   if attempt==2:break
+   shift=target-np.asarray(lm,np.float32)[LIPS,:2].mean(0);n=float(np.linalg.norm(shift))
+   if n>width*.8:shift*=width*.8/n
+   lm=np.asarray(lm,np.float32).copy();lm[:,:2]+=shift
+   out=self.renderer.apply(bgr,lm,self.scale*(1.15 if attempt else 1.),self.opacity,self.offset)
+  self.lip_exposed_count=getattr(self,'lip_exposed_count',0)+1
+  return None,lm
  def untracked(self,bgr,index):
   self.previous=None
   if not(self.fitted_mask and self.guard=='protect'):return bgr
@@ -87,6 +126,9 @@ class FaceEffect:
    lm=np.array([(p.x*w,p.y*h,p.z*w) for p in result.face_landmarks[0]],np.float32)
   out=self.renderer.apply(bgr,lm,self.scale,self.opacity,self.offset)
   if self.fitted_mask and self.guard=='protect' and (self.renderer.last_coverage if self.mouth_cover else self.renderer.accessory.last_coverage)<.98:return self.protected(bgr,lm)
+  if self.fitted_mask and self.guard=='protect' and not self.mouth_cover:
+   out,lm=self.lip_safety(bgr,lm,out)
+   if out is None:return self.protected(bgr,lm)
   self.tracked+=1
   out=self.occlusion.apply(bgr,out,lm,strict=self.fitted_mask)
   hands=self.hands.process(rgb)
diff --git a/tests/test_lip_safety.py b/tests/test_lip_safety.py
new file mode 100644
index 0000000..d7e00ba
--- /dev/null
+++ b/tests/test_lip_safety.py
@@ -0,0 +1,79 @@
+import numpy as np
+import pytest
+from app.processing import FaceEffect
+from app.face_flow_gaps import LIPS
+
+H, W = 200, 160
+
+
+def landmarks(mouth_x, mouth_y):
+    p = np.zeros((478, 3), np.float32)
+    p[:468, 0] = np.linspace(40, 120, 468); p[:468, 1] = np.linspace(0, 199, 468)  # face box; crop starts at the origin
+    p[LIPS, 0] = mouth_x + np.linspace(-15, 15, len(LIPS)); p[LIPS, 1] = mouth_y
+    p[61, 0], p[291, 0] = mouth_x - 15, mouth_x + 15
+    return p
+
+
+class Acc:
+    """Renders an opaque 40x24 box centred on the landmark mouth."""
+    def __init__(self): self.last_alpha = None; self.last_coverage = 1.
+    def draw(self, lm, scale):
+        c = np.asarray(lm)[LIPS, :2].mean(0); a = np.zeros((H, W), np.float32)
+        hw, hh = 20 * scale, 12 * scale
+        a[int(c[1] - hh):int(c[1] + hh), int(c[0] - hw):int(c[0] + hw)] = 1; self.last_alpha = a
+
+
+class Renderer:
+    def __init__(self): self.accessory = Acc(); self.calls = 0
+    def apply(self, bgr, lm, scale, opacity, offset):
+        self.calls += 1; self.accessory.draw(lm, scale); return bgr.copy()
+
+
+class Parser:
+    def __init__(self, box): self.box = box
+    def lip_mask(self, roi):  # box is in full-frame coordinates; the crop starts at the origin here
+        m = np.zeros(roi.shape[:2], bool); y0, y1, x0, x1 = self.box; m[y0:y1, x0:x1] = True; return m
+
+
+def effect(lip_box):
+    e = FaceEffect.__new__(FaceEffect)
+    e.renderer = Renderer(); e.mouth_refiner = Parser(lip_box); e.scale = 1.; e.opacity = 1.; e.offset = 0
+    return e
+
+
+def run(e, lm):
+    bgr = np.zeros((H, W, 3), np.uint8); out = e.renderer.apply(bgr, lm, 1., 1., 0)
+    return e.lip_safety(bgr, lm, out)
+
+
+def test_correct_landmarks_are_left_alone():
+    e = effect((96, 104, 70, 90)); lm = landmarks(80, 100)
+    out, lm2 = run(e, lm)
+    assert out is not None and e.renderer.calls == 1 and np.allclose(lm2, lm)
+
+
+def test_mask_rendered_too_low_moves_onto_the_real_lips():
+    e = effect((76, 84, 70, 90)); lm = landmarks(80, 100)  # lips are 20 px above the landmark mouth
+    out, lm2 = run(e, lm)
+    assert out is not None and e.renderer.calls == 2 and getattr(e, 'lip_fix_count', 0) == 1
+    assert np.asarray(lm2)[LIPS, 1].mean() < 90
+
+
+def test_lips_that_cannot_be_covered_are_reported():
+    e = effect((60, 120, 50, 110)); lm = landmarks(80, 90)  # far larger than any allowed wearable
+    out, _ = run(e, lm)
+    assert out is None and e.lip_exposed_count == 1
+
+
+def test_far_away_pink_regions_are_ignored():
+    e = effect((180, 195, 5, 40)); lm = landmarks(80, 100)  # e.g. a pink collar below the face
+    out, lm2 = run(e, lm)
+    assert out is not None and e.renderer.calls == 1
+
+
+def test_parser_failure_keeps_existing_result():
+    class Broken:
+        def lip_mask(self, roi): raise RuntimeError('model missing')
+    e = effect((0, 1, 0, 1)); e.mouth_refiner = Broken(); lm = landmarks(80, 100)
+    out, _ = run(e, lm)
+    assert out is not None
