From 0d1edaae085182e26d8aa64531b3dc2a87b8c85c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 5 Nov 2026 17:26:09 +0900
Subject: [PATCH] fix(asr): word timestamps with batch_size=1; strip leading
 punctuation of regrouped sentences

On the 5090 the chunked word-timestamp call failed with batch_size=4 (IndexError) and fell
back to the collapsed segment timestamps; with batch_size=1 it returns usable phrase timing.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015XEHdEnhr7p5ae4FL4TjbE
---
 scripts/speech_infer.py   |  5 +++--
 tests/test_thai_timing.py | 10 ++++++++++
 2 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/scripts/speech_infer.py b/scripts/speech_infer.py
index 6b8577a..9f905e6 100644
--- a/scripts/speech_infer.py
+++ b/scripts/speech_infer.py
@@ -18,7 +18,8 @@ def asr(spec):
   # Segment-level timestamps collapse on continuous live-stream speech with music (seen: one
   # 46 s "sentence" followed by fixed 2 s windows). Word timestamps are re-grouped into
   # natural sentences at pauses instead; the old segment mode stays as the fallback.
-  words=model({'raw':audio,'sampling_rate':sr},return_timestamps='word',generate_kwargs=generate,batch_size=4)
+  # batch_size>1 breaks word alignment in transformers' chunked mode (IndexError on the 5090 runs).
+  words=model({'raw':audio,'sampling_rate':sr},return_timestamps='word',generate_kwargs=generate,batch_size=1)
   result=sentences_from_words(words,len(audio)/sr)
   Path(spec['output']).with_name(Path(spec['output']).stem+'-words.json').write_text(json.dumps(words,ensure_ascii=False,indent=1))
  except Exception as e:
@@ -45,7 +46,7 @@ def sentences_from_words(words,duration,pause=.4,soft=6.,hard=9.,min_len=1.):
  for g in groups:
   if merged and (g[-1][1]-g[0][0]<min_len or merged[-1][-1][1]-merged[-1][0][0]<min_len) and g[0][0]-merged[-1][-1][1]<.3:merged[-1]+=g
   else:merged.append(g)
- chunks=[{'text':''.join(x[2] for x in g).strip(),'timestamp':[round(g[0][0],3),round(min(duration,g[-1][1]),3)]} for g in merged]
+ chunks=[{'text':''.join(x[2] for x in g).strip().lstrip(',，?？!！。、;； '),'timestamp':[round(g[0][0],3),round(min(duration,g[-1][1]),3)]} for g in merged]
  return {'text':''.join(c['text'] for c in chunks),'chunks':chunks,'segmentation':'word-pauses'}
 
 def thai_tts(spec):
diff --git a/tests/test_thai_timing.py b/tests/test_thai_timing.py
index 7e954d5..d6e430d 100644
--- a/tests/test_thai_timing.py
+++ b/tests/test_thai_timing.py
@@ -59,3 +59,13 @@ def test_alignment_may_use_the_silence_before_the_next_sentence(tmp_path):
     assert r.returncode == 0, r.stderr[-500:]
     proof = json.loads(Path(str(out) + '.alignment.json').read_text())
     assert proof[0]['speed'] == 1.0          # 2.6 s fits before the next sentence at 3.0 s, no speed-up
+
+
+def test_real_word_chunks_from_the_5090_run_regroup_cleanly():
+    # Shape of transformers' word-mode output on the live clip (batch_size=1), incl. leading commas.
+    seq = [('对这条灰的裤子拿下过来', 0.0, 1.94), ('然后我身上这个直接开过了宝宝', 2.26, 4.8),
+           (',然后你搭这个卡的是不是也好看', 28.68, 30.46), ('?是', 30.46, 30.76), (',开过没上衣', 30.76, 31.86),
+           ('?开好了', 31.86, 32.36), (',很凉快', 32.36, 33.18)]
+    out = speech_infer.sentences_from_words(words(seq), 34)
+    assert all(not c['text'][0] in ',?，？' for c in out['chunks'])
+    assert max(c['timestamp'][1] - c['timestamp'][0] for c in out['chunks']) <= 9.5
