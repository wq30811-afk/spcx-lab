index 3e85493..d19d0ae 100644
--- a/app/face_flow_gaps.py
+++ b/app/face_flow_gaps.py
@@ -1,6 +1,45 @@
 """Bounded reverse image tracking for missing detections; never interpolate geometry."""
-import cv2
+import cv2,numpy as np
 from .face_flow import follow
+LIPS=[61,40,37,0,267,270,291,321,314,17,84,91,13,14]
+
+def _edge_gap(p,w,h,margin):
+ """Distance from the lips to the nearest frame edge they are leaving (<=0: already crossing)."""
+ lips=np.asarray(p,np.float32)[LIPS,:2]
+ return float(min(lips[:,1].min(),lips[:,0].min(),w-lips[:,0].max(),h-lips[:,1].max()))
+
+def _motion(points,anchor,step,count=3):
+ """Lip-centre displacement per frame, extrapolating from the tracked side into the gap
+ (time order follows `step`: +1 forward after an exit, -1 backward before an entry)."""
+ seq=[]
+ for j in range(count+1):
+  k=anchor-step*j
+  if 0<=k<len(points) and points[k] is not None:seq.append(np.asarray(points[k],np.float32)[LIPS,:2].mean(0))
+  else:break
+ return (seq[0]-seq[-1])/(len(seq)-1) if len(seq)>1 else np.zeros(2,np.float32)
+
+def edge_extend(points,w,h,cuts=(),limit=12,margin=None):
+ """A face leaving (or entering) through a frame edge loses its landmarks while a sliver
+ of lip can still be on screen. Carry the last wearable along the lips' own motion for at
+ most `limit` frames, only when those lips were already at the edge, never across a shot
+ cut and never deeper into the frame. The wearable then slides out instead of vanishing."""
+ margin=margin if margin is not None else .08*min(w,h);filled=[];n=len(points);i=0
+ while i<n:
+  if points[i] is not None:i+=1;continue
+  a=i
+  while i<n and points[i] is None:i+=1
+  b=i-1
+  for anchor,step in ((a-1,1),(b+1,-1)):
+   if not 0<=anchor<n or points[anchor] is None or _edge_gap(points[anchor],w,h,margin)>margin:continue
+   v=_motion(points,anchor,step)
+   for d in range(1,limit+1):
+    k=anchor+step*d
+    if not a<=k<=b or points[k] is not None:break
+    if any(min(anchor,k)<c<=max(anchor,k) for c in cuts):break
+    q=np.asarray(points[anchor],np.float32).copy();q[:,:2]+=v*d
+    if _edge_gap(q,w,h,margin)>margin:break
+    points[k]=q;filled.append(k)
+ return filled
 
 def recover(path,points,limit=30):
  cap=cv2.VideoCapture(str(path));count=0;seed=None;frame=None;lm=None;distance=0
