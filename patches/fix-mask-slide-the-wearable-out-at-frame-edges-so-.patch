diff --git a/tests/test_edge_exit.py b/tests/test_edge_exit.py
new file mode 100644
index 0000000..ce8ef87
--- /dev/null
+++ b/tests/test_edge_exit.py
@@ -0,0 +1,46 @@
+import numpy as np
+from app.face_flow_gaps import edge_extend, LIPS
+
+W, H = 720, 1280
+
+
+def face(mouth_y, x=360.0):
+    """478 landmarks; the lip points sit around (x, mouth_y)."""
+    p = np.zeros((478, 3), np.float32); p[:, 0] = x; p[:, 1] = mouth_y + 200
+    p[LIPS, 1] = mouth_y; p[LIPS, 0] = x + np.linspace(-30, 30, len(LIPS))
+    return p
+
+
+def mouth(p): return float(np.asarray(p)[LIPS, 1].mean())
+
+
+def test_exit_through_top_slides_the_wearable_out():
+    pts = [face(100), face(70), face(40), face(10)] + [None] * 8 + [face(400)]
+    filled = edge_extend(pts, W, H, limit=12)
+    assert filled[:3] == [4, 5, 6]
+    assert mouth(pts[4]) < mouth(pts[3]) and mouth(pts[5]) < mouth(pts[4])  # keeps moving up and out
+
+
+def test_entry_through_top_is_covered_backwards():
+    pts = [face(400)] + [None] * 6 + [face(8), face(38), face(68)]
+    filled = edge_extend(pts, W, H, limit=12)
+    assert 6 in filled and mouth(pts[6]) < 8
+
+
+def test_face_in_the_middle_of_the_frame_is_never_extended():
+    pts = [face(600), face(610)] + [None] * 5 + [face(640)]
+    assert edge_extend(pts, W, H) == [] and pts[2] is None
+
+
+def test_never_across_a_shot_cut_and_bounded():
+    pts = [face(30), face(10)] + [None] * 20
+    filled = edge_extend(pts, W, H, cuts=[5], limit=12)
+    assert filled == [2, 3, 4]
+    pts = [face(30), face(10)] + [None] * 20
+    assert len(edge_extend(pts, W, H, limit=6)) == 6
+
+
+def test_hovering_at_the_edge_keeps_cover_without_moving_inward():
+    pts = [face(10), face(10), face(10)] + [None] * 3
+    filled = edge_extend(pts, W, H, limit=12)
+    assert filled == [3, 4, 5] and all(abs(mouth(pts[k]) - 10) < 1e-3 for k in filled)
