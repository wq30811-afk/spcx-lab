diff --git a/app/face_flow.py b/app/face_flow.py
index a681f26..f7bcc71 100644
--- a/app/face_flow.py
+++ b/app/face_flow.py
@@ -36,3 +36,19 @@ def follow(previous,current,points,allow_partial=False):
   # the chin is still visible. No pixels are synthesized for that interval.
   if not (allow_partial and -h*.2<center[1]<0 and 0<result[152,1]<h and 0<result[152,0]<w):return None
  return result
+
+BROWS=([70,63,105,66,107],[336,296,334,293,300])
+def _anchors(p):return np.array([p[BROWS[0],:2].mean(0),p[BROWS[1],:2].mean(0),p[1,:2]])
+def verify(previous,current,previous_points,detected,tolerance=.15):
+ """Cross-check a fresh detection against the pixels. A detector can misplace the whole face
+ for several frames (e.g. after a hand sweeps past) while the image barely changes. When the
+ detection jumps from the previous points by more than `tolerance` of the face size and
+ optical flow of the actual face texture disagrees by as much, the flow-tracked points are
+ returned instead. Returns (points, overridden)."""
+ if detected is None or previous_points is None or not np.isfinite(previous_points[[1]+BROWS[0]+BROWS[1],:2]).all():return detected,False
+ a,d=_anchors(previous_points),_anchors(detected);size=float(np.linalg.norm(a[0]-a[1])) or 1.
+ if float(np.linalg.norm(d-a,axis=1).max())/size<=tolerance:return detected,False
+ tracked=follow(previous,current,previous_points)
+ if tracked is None:return detected,False
+ if float(np.linalg.norm(d-_anchors(tracked),axis=1).max())/size<=tolerance:return detected,False
+ return tracked,True
diff --git a/app/lip_temporal.py b/app/lip_temporal.py
index 0af9722..4187d57 100644
--- a/app/lip_temporal.py
+++ b/app/lip_temporal.py
@@ -1,10 +1,14 @@
 """Temporal sanity for lip-sync geometry.
 
-Fast hand motion and motion blur occasionally give one or two frames of badly placed
-landmarks. Those frames drive both the face alignment (what LatentSync sees) and the mouth
-envelope (where the generated mouth is pasted), so the result is a twisted, oversized mouth
-for a flash. A real face cannot jump in position, size or angle for a single frame, so such
-frames are detected against their neighbours and re-estimated from the surrounding good frames.
+The face tracker occasionally returns one or two frames of badly placed landmarks (for example
+just after a hand sweeps past the face). Those frames drive both the face alignment (what
+LatentSync sees) and the mouth envelope (where the generated mouth is pasted), so the result is a
+twisted mouth for a flash.
+
+Only out-and-back spikes are repaired: a run of 1-2 frames that leaves the straight line between
+its neighbours by more than the neighbours themselves move. Fast real motion (leaning in,
+turning, bending down) moves the neighbours too and is never touched, because interpolating over
+real motion misplaces the face crop and causes exactly the twisted mouth it is meant to prevent.
 """
 import numpy as np
 
@@ -17,36 +21,39 @@ def anchors(p):
     return np.array([p[BROW_L, :2].mean(0), p[BROW_R, :2].mean(0), p[NOSE, :2]])
 
 
-def outliers(landmarks, window=3, tolerance=.15):
-    """Frames whose alignment anchors deviate from the median of their neighbours by more than
-    `tolerance` of the face size (brow-to-brow distance), or whose size jumps by > 20%."""
-    q = np.stack([anchors(p) for p in landmarks]); n = len(q); bad = []
+def outliers(landmarks, tolerance=.15, max_run=2):
+    """Frames in a run of at most `max_run` that jump away from, and back to, the line between
+    the frames on either side: deviation > `tolerance` of the face size (brow-to-brow distance)
+    and larger than the motion between those two neighbours, or a size flash outside 0.8-1.25."""
+    q = np.stack([anchors(p) for p in landmarks]); n = len(q); bad = set()
     size = np.linalg.norm(q[:, 0] - q[:, 1], axis=1)
-    for i in range(n):
-        # Symmetric neighbourhoods only: their median is unbiased for steady motion, and
-        # robust to a second glitch frame among the neighbours.
-        if i < window or i >= n - window: continue
-        nb = [j for j in range(i - window, i + window + 1) if j != i]
-        ref = np.median(q[nb], axis=0); ref_size = float(np.median(size[nb])) or 1.0
-        dev = float(np.linalg.norm(q[i] - ref, axis=1).max()) / ref_size
-        if dev > tolerance or not .8 <= size[i] / ref_size <= 1.25: bad.append(i)
-    return bad
-
-
-def repair(landmarks, max_gap=6, **kw):
-    """Return (landmarks, repaired indices). Outlier frames are linearly interpolated between
-    the nearest good frames on both sides (at most `max_gap` frames away); if only one side
-    exists the nearest good frame is copied. Frames without a close good neighbour are kept."""
-    lm = np.array(landmarks, np.float32, copy=True); bad = set(outliers(lm, **kw)); fixed = []
-    good = [i for i in range(len(lm)) if i not in bad]
-    for i in sorted(bad):
-        left = max((g for g in good if g < i), default=None); right = min((g for g in good if g > i), default=None)
-        if left is not None and i - left > max_gap: left = None
-        if right is not None and right - i > max_gap: right = None
-        if left is None and right is None: continue
-        if left is None: lm[i] = lm[right]
-        elif right is None: lm[i] = lm[left]
-        else:
-            t = (i - left) / (right - left); lm[i] = lm[left] * (1 - t) + lm[right] * t
-        fixed.append(i)
+    for run in range(1, max_run + 1):
+        for i in range(1, n - run):
+            a, b = i - 1, i + run
+            if a in bad: continue
+            ref = float((size[a] + size[b]) / 2) or 1.0
+            moved = float(np.linalg.norm(q[b] - q[a], axis=1).max()) / ref
+            if abs(size[a] / max(size[b], 1e-6) - 1) > .2: continue      # neighbours disagree: real change
+            run_bad = []
+            for j in range(i, b):
+                t = (j - a) / (b - a); expect = q[a] * (1 - t) + q[b] * t
+                dev = float(np.linalg.norm(q[j] - expect, axis=1).max()) / ref
+                flash = not .8 <= size[j] / ref <= 1.25
+                run_bad.append((dev > tolerance and dev > moved) or flash)
+            if all(run_bad): bad.update(range(i, b))
+    return sorted(bad)
+
+
+def repair(landmarks, **kw):
+    """Return (landmarks, repaired indices). Spike frames are linearly interpolated between the
+    good frames directly around them."""
+    lm = np.array(landmarks, np.float32, copy=True); bad = outliers(lm, **kw); fixed = []
+    bad_set = set(bad)
+    for i in bad:
+        left = i - 1
+        while left in bad_set: left -= 1
+        right = i + 1
+        while right in bad_set: right += 1
+        if left < 0 or right >= len(lm): continue
+        t = (i - left) / (right - left); lm[i] = lm[left] * (1 - t) + lm[right] * t; fixed.append(i)
     return lm, fixed
