    h,w=bgr.shape[:2];p=np.asarray(lm,np.float32)[:468,:2];lo=p.min(0);hi=p.max(0);cx,cy=(lo+hi)/2;side=max(hi-lo)*1.3
-   x0,y0,x1,y1=max(0,int(cx-side/2)),max(0,int(cy-side/2)),min(w,int(cx+side/2)),min(h,int(cy+side/2))
-   if x1-x0<16 or y1-y0<16:return out,lm
-   lips=np.zeros((h,w),bool);lips[y0:y1,x0:x1]=self.mouth_refiner.lip_mask(bgr[y0:y1,x0:x1])
+   crop,paste=square_crop(bgr,cx,cy,side)
+   if crop is None or side<16:return out,lm
+   lips=paste(self.mouth_refiner.lip_mask(crop))
   except Exception:
    return out,lm
   from .face_flow_gaps import LIPS
@@ -235,6 +235,18 @@ class FaceEffect:
   if self.refiner:self.refiner.close()
   if self.guard_model:self.guard_model.close()
 
+def square_crop(img,cx,cy,side):
+ """Square crop centred on (cx,cy); parts outside the frame are padded with neutral grey
+ instead of being clipped and stretched (a stretched half-face hides the lips from the parser).
+ Returns (crop, paste) where paste(mask) maps a crop-sized mask back to a full-frame mask."""
+ h,w=img.shape[:2];half=max(8,int(side/2));x0,y0=int(cx)-half,int(cy)-half;x1,y1=x0+2*half,y0+2*half
+ cx0,cy0,cx1,cy1=max(0,x0),max(0,y0),min(w,x1),min(h,y1)
+ if cx1<=cx0 or cy1<=cy0:return None,None
+ crop=cv2.copyMakeBorder(img[cy0:cy1,cx0:cx1],cy0-y0,y1-cy1,cx0-x0,x1-cx1,cv2.BORDER_CONSTANT,value=(127,127,127))
+ def paste(mask):
+  full=np.zeros((h,w),bool);full[cy0:cy1,cx0:cx1]=mask[cy0-y0:cy0-y0+cy1-cy0,cx0-x0:cx0-x0+cx1-cx0];return full
+ return crop,paste
+
 def grow_edge(out,alpha,need,max_px=10):
  """Extend the rendered wearable by up to `max_px` pixels, only toward `need` pixels
  (dilated by 2 px for margin), colouring new pixels from the wearable's own edge.
diff --git a/tests/test_lip_safety.py b/tests/test_lip_safety.py
