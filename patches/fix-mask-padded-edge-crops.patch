-   roi=bgr[max(0,int(cy-side/2)):min(h,int(cy+side/2)),max(0,int(cx-side/2)):min(w,int(cx+side/2))]
+   roi,_=square_crop(bgr,cx,cy,side)
    if self.mouth_refiner is None:
