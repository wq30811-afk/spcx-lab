     e = effect((84, 89, 70, 90)); lm = landmarks(80, 100)  # mask starts at y=88: rows 84-87 exposed
-    bgr = np.zeros((H, W, 3), np.uint8); out = np.full_like(bgr, 50)
+    bgr = frame_with_lips(e.mouth_refiner.box); out = np.full_like(bgr, 50)
