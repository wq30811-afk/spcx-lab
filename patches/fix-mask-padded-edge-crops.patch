-        m = np.zeros(roi.shape[:2], bool); y0, y1, x0, x1 = self.box; m[y0:y1, x0:x1] = True; return m
+    def lip_mask(self, roi): return (roi[..., 2] == 200) & (roi[..., 1] == 0)
