From 9878b74828b7154bd737330ab1ce19d53d69b0b0 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 2 Nov 2026 20:32:10 +0900
Subject: [PATCH] fix(mask): smoothing splits runs where the landmark set
 changes (478 vs 468 points)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015XEHdEnhr7p5ae4FL4TjbE
---
 app/landmark_smooth.py        | 5 +++--
 tests/test_landmark_smooth.py | 7 +++++++
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/app/landmark_smooth.py b/app/landmark_smooth.py
index 944e163..2730983 100644
--- a/app/landmark_smooth.py
+++ b/app/landmark_smooth.py
@@ -31,8 +31,9 @@ def smooth(points, fps, cuts=(), scale=None, min_cutoff=1.0, beta=0.02):
     out = list(points); cuts = set(cuts); n = len(points); i = 0
     while i < n:
         if points[i] is None: i += 1; continue
-        a = i; i += 1
-        while i < n and points[i] is not None and i not in cuts: i += 1
+        a = i; i += 1; shape = np.shape(points[a])
+        # Different fallbacks return different point sets (478 vs 468): a change ends the run.
+        while i < n and points[i] is not None and i not in cuts and np.shape(points[i]) == shape: i += 1
         run = np.stack([np.asarray(p, np.float32) for p in points[a:i]])
         if len(run) < 3: continue
         s = scale or float(np.ptp(run[0][:468, 0])) or 1.0
diff --git a/tests/test_landmark_smooth.py b/tests/test_landmark_smooth.py
index 857e621..5a6a989 100644
--- a/tests/test_landmark_smooth.py
+++ b/tests/test_landmark_smooth.py
@@ -39,3 +39,10 @@ def test_short_runs_and_input_are_untouched():
     pts = [face(100, 400), face(130, 400)]
     out = smooth(pts, FPS)
     assert out[0] is pts[0] and out[1] is pts[1]
+
+
+def test_mixed_landmark_sets_do_not_crash_and_are_not_blended():
+    a = [face(100, 400)] * 5; b = [face(300, 400)[:468]] * 5
+    out = smooth(a + b + a, FPS)
+    assert [np.shape(p)[0] for p in out] == [478] * 5 + [468] * 5 + [478] * 5
+    assert np.allclose(out[5], b[0]) and np.allclose(out[4], a[0])
-- 
