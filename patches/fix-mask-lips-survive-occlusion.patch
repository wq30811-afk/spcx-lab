From f194cc2d2f53c2607639d8adf788d20008f5ca51 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 2 Nov 2026 20:31:11 +0900
Subject: [PATCH] fix(mask): occlusion carving can no longer uncover visible
 lips

On profiles XSeg can classify the real lips as an occluder and cut the wearable away over
them, after the coverage checks had passed. Lips found in the current frame are not behind
anything, so wearable pixels over them are restored after occlusion; hands and phones that
hide the mouth are unaffected because hidden lips are not detected.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015XEHdEnhr7p5ae4FL4TjbE
---
 app/processing.py        | 14 ++++++++++----
 tests/test_lip_safety.py | 19 +++++++++++++++++++
 2 files changed, 29 insertions(+), 4 deletions(-)

diff --git a/app/processing.py b/app/processing.py
index 416510d..698da0b 100644
--- a/app/processing.py
+++ b/app/processing.py
@@ -73,7 +73,7 @@ class FaceEffect:
   sit under the rendered wearable. Misplaced landmarks (profile, partial face) are corrected
   by moving/enlarging the wearable toward the real lips; if that still leaves lips exposed
   the frame returns None and the existing guard decides. A failing check keeps `out`."""
-  acc=getattr(self.renderer,'accessory',None)
+  acc=getattr(self.renderer,'accessory',None);self.frame_lips=None
   if acc is None:return out,lm
   try:
    if self.mouth_refiner is None:
@@ -91,7 +91,7 @@ class FaceEffect:
   P=np.asarray(lm,np.float32);mouth=P[LIPS,:2].mean(0);width=float(np.linalg.norm(P[61,:2]-P[291,:2]))+1;reach=max(width*1.6,max(hi-lo)*.25)
   n,labels,stats,centers=cv2.connectedComponentsWithStats(lips.astype(np.uint8));near=np.zeros(n,bool)
   for k in range(1,n):near[k]=np.linalg.norm(centers[k]-mouth)<=reach
-  lips=near[labels];total=int(lips.sum())
+  lips=near[labels];total=int(lips.sum());self.frame_lips=lips if total>=10 else None
   if total<10:return out,lm
   ys,xs=np.where(lips);target=np.array([xs.mean(),ys.mean()],np.float32)
   for attempt in range(3):
@@ -116,7 +116,7 @@ class FaceEffect:
    return bgr
   return self.protected(bgr)
  def apply(self,bgr,index,fps):
-  h,w=bgr.shape[:2];rgb=cv2.cvtColor(bgr,cv2.COLOR_BGR2RGB)
+  h,w=bgr.shape[:2];rgb=cv2.cvtColor(bgr,cv2.COLOR_BGR2RGB);self.frame_lips=None
   if self.cached is not None:
    lm=self.cached[index] if index<len(self.cached) else None
    if lm is None:return self.untracked(bgr,index)
@@ -130,7 +130,13 @@ class FaceEffect:
    out,lm=self.lip_safety(bgr,lm,out)
    if out is None:return self.protected(bgr,lm)
   self.tracked+=1
-  out=self.occlusion.apply(bgr,out,lm,strict=self.fitted_mask)
+  effect=out;out=self.occlusion.apply(bgr,out,lm,strict=self.fitted_mask)
+  lips=getattr(self,'frame_lips',None);acc=getattr(self.renderer,'accessory',None)
+  if lips is not None and acc is not None and getattr(acc,'last_alpha',None) is not None:
+   # XSeg can call the real lips an occluder on profiles and carve the wearable away
+   # there. Visible lips are by definition not hidden behind anything, so they stay covered.
+   keep=(cv2.dilate(lips.astype(np.uint8),np.ones((5,5),np.uint8))>0)&(acc.last_alpha>.5)&np.any(out!=effect,axis=2)
+   if keep.any():out[keep]=effect[keep];self.lip_restored_count=getattr(self,'lip_restored_count',0)+1
   hands=self.hands.process(rgb)
   if hands.multi_hand_landmarks:
    for hand in hands.multi_hand_landmarks:
diff --git a/tests/test_lip_safety.py b/tests/test_lip_safety.py
index d7e00ba..5cbe90a 100644
--- a/tests/test_lip_safety.py
+++ b/tests/test_lip_safety.py
@@ -77,3 +77,22 @@ def test_parser_failure_keeps_existing_result():
     e = effect((0, 1, 0, 1)); e.mouth_refiner = Broken(); lm = landmarks(80, 100)
     out, _ = run(e, lm)
     assert out is not None
+
+
+def test_occlusion_cannot_carve_the_wearable_off_visible_lips():
+    from types import SimpleNamespace
+    e = effect((96, 104, 70, 90)); lm = landmarks(80, 100)
+    e.cached = [lm]; e.fitted_mask = True; e.guard = 'protect'; e.mouth_cover = False
+    e.tracked = 0; e.previous = None
+    class Carve:  # XSeg calling the real lips an occluder: restores original pixels there
+        def apply(self, original, effect_img, p, strict=False):
+            out = effect_img.copy(); out[90:110, 60:100] = original[90:110, 60:100]; return out
+    e.occlusion = Carve()
+    e.renderer.apply = lambda bgr, lm_, scale, opacity, offset: (e.renderer.accessory.draw(lm_, scale), np.full_like(bgr, 7))[1]
+    e.hands = SimpleNamespace(process=lambda rgb: SimpleNamespace(multi_hand_landmarks=None))
+    e.detector = SimpleNamespace(detect=lambda img: SimpleNamespace(detections=[]))
+    e.mp = SimpleNamespace(Image=lambda **k: None, ImageFormat=SimpleNamespace(SRGB=0))
+    out = e.apply(np.zeros((H, W, 3), np.uint8), 0, 24)
+    assert (out[96:104, 70:90] == 7).all()          # lips stay under the wearable
+    assert (out[106:110, 62:68] == 0).all()         # the rest of the carve is respected
+    assert e.lip_restored_count == 1
