From fa149540b0a118d3cc99ce244dccfa874d4d1fba Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 2 Nov 2026 22:23:47 +0900
Subject: [PATCH] fix(mask): fallback landmarks cannot collapse in size between
 frames

At a frame edge the mouth-region fallback produced a face 57% smaller than the previous
frame; the wearable shrank off the lips and the lip check, cropping around that tiny face,
saw no face context and found no lips. Fallback frames may now change size by at most 7%
per frame (trusted detections untouched), and the lip-check crop has a minimum size.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015XEHdEnhr7p5ae4FL4TjbE
---
 app/face_flow_gaps.py   | 24 ++++++++++++++++++++++++
 app/processing.py       |  8 ++++++--
 tests/test_edge_exit.py | 16 ++++++++++++++++
 3 files changed, 46 insertions(+), 2 deletions(-)

diff --git a/app/face_flow_gaps.py b/app/face_flow_gaps.py
index 41cbc7c..a8ac674 100644
--- a/app/face_flow_gaps.py
+++ b/app/face_flow_gaps.py
@@ -57,3 +57,27 @@ def recover(path,points,limit=30):
    points[i]=fresh;count+=1;seed=i;frame=current;lm=fresh;distance+=1
  finally:cap.release()
  return count
+
+TRUSTED=('direct','refined')
+
+def limit_scale_jumps(points,qualities,cuts=(),step=.07):
+ """Fallback landmarks (mouth-region estimate, flow, edge continuation) can collapse in size
+ from one frame to the next (seen: 57% smaller in one frame at a frame edge), which shrinks
+ the wearable off the lips. Real faces do not change size that fast, so a fallback frame's
+ size may differ from the previous frame by at most `step`; it is rescaled about its own
+ lip centre. Trusted detections are never changed. Returns the indices adjusted."""
+ cuts=set(cuts);fixed=[];prev=None
+ for i,p in enumerate(points):
+  if p is None or i in cuts:prev=None if p is None else _size(p);continue
+  size=_size(p)
+  if prev is not None and qualities[i] not in TRUSTED and size>0:
+   lo,hi=prev*(1-step),prev*(1+step)
+   if not lo<=size<=hi:
+    target=min(max(size,lo),hi);k=target/size;q=np.asarray(p,np.float32).copy();c=q[LIPS,:2].mean(0)
+    q[:,:2]=c+(q[:,:2]-c)*k;q[:,2]*=k;points[i]=q;fixed.append(i);size=target
+  prev=size
+ return fixed
+
+def _size(p):
+ """Face size from the lip corners (61, 291) and chin/nose (152, 1): present in every set."""
+ p=np.asarray(p,np.float32);return float(np.linalg.norm(p[61,:2]-p[291,:2])+np.linalg.norm(p[1,:2]-p[152,:2]))
diff --git a/app/processing.py b/app/processing.py
index bff9aba..e9ca19f 100644
--- a/app/processing.py
+++ b/app/processing.py
@@ -79,7 +79,9 @@ class FaceEffect:
    if self.mouth_refiner is None:
     from .mouth_region import MouthRegion
     self.mouth_refiner=MouthRegion()
-   h,w=bgr.shape[:2];p=np.asarray(lm,np.float32)[:468,:2];lo=p.min(0);hi=p.max(0);cx,cy=(lo+hi)/2;side=max(hi-lo)*1.3
+   h,w=bgr.shape[:2];p=np.asarray(lm,np.float32)[:468,:2];lo=p.min(0);hi=p.max(0);cx,cy=(lo+hi)/2
+   # The parser needs face context around the lips: never a crop smaller than ~1/6 of the frame.
+   side=max(max(hi-lo)*1.3,min(h,w)*.18)
    crop,paste=square_crop(bgr,cx,cy,side)
    if crop is None or side<16:return out,lm
    lips=paste(self.mouth_refiner.lip_mask(crop))
@@ -205,7 +207,9 @@ class FaceEffect:
    for k,was_missing in enumerate(missing):
     if was_missing and points[k] is not None:qualities[k]='reverse_flow'
    if points:
-    from .face_flow_gaps import edge_extend
+    from .face_flow_gaps import edge_extend,limit_scale_jumps
+    # Size first, so an edge continuation starts from a corrected (not collapsed) face.
+    self.scale_fixed_count=len(limit_scale_jumps(points,qualities,cuts))
     for k in edge_extend(points,w,h,cuts,limit=max(4,int(round(fps*.5)))):qualities[k]='edge_exit'
   self.edge_count=qualities.count('edge_exit')
   self.qualities=qualities;valid=[i for i,p in enumerate(points) if p is not None];self.detected_count=sum(q not in ('none','flow','reverse_flow') for q in qualities);limit=max(1,int(fps*.75))
diff --git a/tests/test_edge_exit.py b/tests/test_edge_exit.py
index ce8ef87..6224b73 100644
--- a/tests/test_edge_exit.py
+++ b/tests/test_edge_exit.py
@@ -44,3 +44,19 @@ def test_hovering_at_the_edge_keeps_cover_without_moving_inward():
     pts = [face(10), face(10), face(10)] + [None] * 3
     filled = edge_extend(pts, W, H, limit=12)
     assert filled == [3, 4, 5] and all(abs(mouth(pts[k]) - 10) < 1e-3 for k in filled)
+
+
+def test_fallback_landmarks_cannot_collapse_in_size():
+    from app.face_flow_gaps import limit_scale_jumps, _size
+    def scaled(k):
+        p = face(300); c = p[LIPS, :2].mean(0); p[:, :2] = c + (p[:, :2] - c) * k; p[1, 1] = 260; p[152, 1] = 340
+        p[1, 1] = c[1] + (260 - c[1]) * k; p[152, 1] = c[1] + (340 - c[1]) * k; p[61, 0] = c[0] - 30 * k; p[291, 0] = c[0] + 30 * k
+        return p
+    pts = [scaled(1.0), scaled(1.0), scaled(0.43), scaled(0.43)]
+    q = ['direct', 'direct', 'mouth_region', 'flow']
+    fixed = limit_scale_jumps(pts, q)
+    assert fixed == [2, 3]
+    s = [_size(p) for p in pts]
+    assert abs(s[2] / s[1] - 0.93) < 1e-3 and abs(s[3] / s[2] - 0.93) < 1e-3
+    pts2 = [scaled(1.0), scaled(0.43)]
+    assert limit_scale_jumps(pts2, ['direct', 'direct']) == []   # trusted detections untouched
