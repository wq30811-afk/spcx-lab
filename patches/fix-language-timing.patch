  Path(spec['output']).write_text(json.dumps(result,ensure_ascii=False,indent=2));return result
 
+def sentences_from_words(words,duration,pause=.4,soft=6.,hard=9.,min_len=1.):
+ """Group word timestamps into sentences: break at pauses >= `pause` s, at sentence
+ punctuation once 2 s long, at smaller pauses once `soft` s long, and always by `hard` s.
+ Very short pieces are merged into a close neighbour."""
+ items=[]
+ for w in words.get('chunks') or []:
+  t=w.get('timestamp') or (None,None);text=str(w.get('text',''))
+  if t[0] is None or not text.strip():continue
+  items.append((float(t[0]),float(t[1] if t[1] is not None else t[0]+.2),text))
+ if not items:raise ValueError('no word timestamps')
+ groups=[[items[0]]]
+ for a,b in zip(items,items[1:]):
+  g=groups[-1];length=a[1]-g[0][0];gap=b[0]-a[1]
+  if gap>=pause or length>=hard or (length>=2 and a[2].strip()[-1:] in '。！？!?.') or (length>=soft and gap>=.12):groups.append([b])
+  else:g.append(b)
+ merged=[]
+ for g in groups:
+  if merged and (g[-1][1]-g[0][0]<min_len or merged[-1][-1][1]-merged[-1][0][0]<min_len) and g[0][0]-merged[-1][-1][1]<.3:merged[-1]+=g
+  else:merged.append(g)
+ chunks=[{'text':''.join(x[2] for x in g).strip(),'timestamp':[round(g[0][0],3),round(min(duration,g[-1][1]),3)]} for g in merged]
+ return {'text':''.join(c['text'] for c in chunks),'chunks':chunks,'segmentation':'word-pauses'}
+
