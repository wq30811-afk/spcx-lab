+import importlib.util, json, subprocess, sys, wave
+from pathlib import Path
+import numpy as np
+from app.language_core import translation_prompt, shorten_prompt, budget, price_rule, segments_from_asr
+
+ROOT = Path(__file__).resolve().parents[1]
+spec = importlib.util.spec_from_file_location('speech_infer', ROOT / 'scripts/speech_infer.py')
+speech_infer = importlib.util.module_from_spec(spec); spec.loader.exec_module(speech_infer)
+
+
+def words(seq):
+    return {'chunks': [{'text': t, 'timestamp': [s, e]} for t, s, e in seq]}
+
+
+def test_long_continuous_speech_is_split_at_pauses_not_one_46s_block():
+    seq = []; t = 0.0
+    for k in range(120):                       # 120 characters, a 0.6 s pause every 15
+        seq.append(('字', t, t + .25)); t += .3
+        if k % 15 == 14: t += .6
+    out = speech_infer.sentences_from_words(words(seq), t)
+    lens = [c['timestamp'][1] - c['timestamp'][0] for c in out['chunks']]
+    assert len(out['chunks']) == 8 and max(lens) < 9 and out['segmentation'] == 'word-pauses'
+    assert ''.join(c['text'] for c in out['chunks']) == '字' * 120
+
+
+def test_no_pause_is_still_cut_by_the_hard_limit():
+    seq = [('字', i * .3, i * .3 + .28) for i in range(100)]       # 30 s without any pause
+    out = speech_infer.sentences_from_words(words(seq), 30)
+    assert max(c['timestamp'][1] - c['timestamp'][0] for c in out['chunks']) <= 9.5
+
+
+def test_tiny_fragments_merge_with_a_close_neighbour():
+    seq = [('黑', 0, .2), ('色', .2, .4), ('T', .4, .6), ('你', 1.1, 1.3), ('等', 1.3, 1.5), ('一', 1.5, 1.7), ('下', 1.7, 2.6)]
+    out = speech_infer.sentences_from_words(words(seq), 3)
+    assert len(out['chunks']) == 2      # the 0.5 s pause still separates them, each >= 0.6 s
+
+
+def test_prompt_carries_time_budget_and_exchange_rate():
+    rows = [{'id': 0, 'start': 0, 'end': 2.0, 'source': '这件99元'}]
+    p = translation_prompt(rows, target='th', rate=5.08)
+    data = json.loads(p[p.rindex('输入：') + 3:])
+    assert data[0]['max_chars'] == budget(rows[0]) == 26 and data[0]['seconds'] == 2.0
+    assert '5.08泰铢' in p and '503泰铢' in p and '人民币不得擅自改为泰铢' not in p
+    assert '人民币不得擅自改为泰铢' in translation_prompt(rows, target='th')   # unchanged without a rate
+    assert 'max_chars' in shorten_prompt([{'id': 0, 'source': 'x', 'text': 'ยาว', 'max_chars': 8}])
+
+
