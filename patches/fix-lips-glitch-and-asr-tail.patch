+"""Temporal sanity for lip-sync geometry.
+
+Fast hand motion and motion blur occasionally give one or two frames of badly placed
+landmarks. Those frames drive both the face alignment (what LatentSync sees) and the mouth
+envelope (where the generated mouth is pasted), so the result is a twisted, oversized mouth
+for a flash. A real face cannot jump in position, size or angle for a single frame, so such
+frames are detected against their neighbours and re-estimated from the surrounding good frames.
+"""
+import numpy as np
+
+BROW_L = [70, 63, 105, 66, 107]; BROW_R = [336, 296, 334, 293, 300]; NOSE = 1
+
+
+def anchors(p):
+    """The three points the LatentSync alignment uses: left brow, right brow, nose tip."""
+    p = np.asarray(p, np.float64)
+    return np.array([p[BROW_L, :2].mean(0), p[BROW_R, :2].mean(0), p[NOSE, :2]])
+
+
+def outliers(landmarks, window=3, tolerance=.15):
+    """Frames whose alignment anchors deviate from the median of their neighbours by more than
+    `tolerance` of the face size (brow-to-brow distance), or whose size jumps by > 20%."""
+    q = np.stack([anchors(p) for p in landmarks]); n = len(q); bad = []
+    size = np.linalg.norm(q[:, 0] - q[:, 1], axis=1)
+    for i in range(n):
+        # Symmetric neighbourhoods only: their median is unbiased for steady motion, and
+        # robust to a second glitch frame among the neighbours.
+        if i < window or i >= n - window: continue
+        nb = [j for j in range(i - window, i + window + 1) if j != i]
+        ref = np.median(q[nb], axis=0); ref_size = float(np.median(size[nb])) or 1.0
+        dev = float(np.linalg.norm(q[i] - ref, axis=1).max()) / ref_size
+        if dev > tolerance or not .8 <= size[i] / ref_size <= 1.25: bad.append(i)
+    return bad
+
+
+def repair(landmarks, max_gap=6, **kw):
+    """Return (landmarks, repaired indices). Outlier frames are linearly interpolated between
+    the nearest good frames on both sides (at most `max_gap` frames away); if only one side
+    exists the nearest good frame is copied. Frames without a close good neighbour are kept."""
+    lm = np.array(landmarks, np.float32, copy=True); bad = set(outliers(lm, **kw)); fixed = []
+    good = [i for i in range(len(lm)) if i not in bad]
+    for i in sorted(bad):
+        left = max((g for g in good if g < i), default=None); right = min((g for g in good if g > i), default=None)
+        if left is not None and i - left > max_gap: left = None
+        if right is not None and right - i > max_gap: right = None
+        if left is None and right is None: continue
+        if left is None: lm[i] = lm[right]
+        elif right is None: lm[i] = lm[left]
+        else:
+            t = (i - left) / (right - left); lm[i] = lm[left] * (1 - t) + lm[right] * t
+        fixed.append(i)
+    return lm, fixed
