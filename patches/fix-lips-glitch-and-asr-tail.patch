diff --git a/tests/test_lip_temporal.py b/tests/test_lip_temporal.py
new file mode 100644
index 0000000..a685031
--- /dev/null
+++ b/tests/test_lip_temporal.py
@@ -0,0 +1,33 @@
+import numpy as np
+from app.lip_temporal import repair, outliers, BROW_L, BROW_R, NOSE
+
+
+def face(cx, cy, size=100.0, angle=0.0):
+    """478 points; brows and nose placed for a face centred at (cx, cy)."""
+    p = np.zeros((478, 3), np.float32); c, s = np.cos(angle), np.sin(angle)
+    def put(idx, dx, dy):
+        p[idx, 0] = cx + (dx * c - dy * s) * size; p[idx, 1] = cy + (dx * s + dy * c) * size
+    put(list(range(478)), 0, 0); put(BROW_L, -.5, -.4); put(BROW_R, .5, -.4); put([NOSE], 0, .1)
+    return p
+
+
+def test_single_frame_glitch_is_repaired_from_neighbours():
+    track = [face(300 + 2 * i, 400) for i in range(12)]
+    track[6] = face(330, 440, size=150, angle=.5)          # one twisted, oversized frame
+    fixed, idx = repair(track)
+    assert idx == [6]
+    assert np.allclose(fixed[6][BROW_L, 0].mean(), (track[5][BROW_L, 0].mean() + track[7][BROW_L, 0].mean()) / 2, atol=1)
+
+
+def test_two_frame_glitch_like_the_duplicated_25fps_frames():
+    track = [face(300, 400) for _ in range(12)]
+    track[6] = track[7] = face(300, 450, size=140, angle=.4)
+    fixed, idx = repair(track)
+    assert idx == [6, 7] and np.allclose(fixed[6], track[5], atol=1e-3)
+
+
+def test_smooth_fast_motion_is_not_touched():
+    track = [face(200 + 12 * i, 400 + 3 * i, size=100 + i) for i in range(20)]   # quick but continuous
+    assert outliers(track) == []
+    fixed, idx = repair(track)
+    assert idx == [] and np.allclose(fixed, np.array(track))
